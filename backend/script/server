#!/bin/sh

# POSIX baseline
set -eux

# Optional shell extensions, enabled only if the shell supports them
# shellcheck disable=SC3040 # pipefail is probed on the next line
(set -o pipefail) 2>/dev/null && set -o pipefail

CWD="$(pwd)"

# The ERR trap is non-POSIX; install it only where supported
# shellcheck disable=SC3047 # ERR is only trapped if the probe succeeds
if (trap 'exit 1' ERR) 2>/dev/null; then
    # shellcheck disable=SC2064,SC3047 # CWD expands now, $?/$LINENO on signal
    trap "cd ${CWD} && echo >&2 \"Error - exited with status \$? at line \$LINENO\"" ERR
fi

ROOT_DIR="$(cd "$(dirname "$0")/.." 2> /dev/null; pwd -P)"

cd "${ROOT_DIR}"
echo "Current working directory: ${ROOT_DIR}"

echo "Updating database"
uv run python src/manage.py migrate

echo "Starting Celery worker"
uv run celery -A twin4dem worker -l info &

echo "Running web app"
exec uv run python src/manage.py runserver 0.0.0.0:8000